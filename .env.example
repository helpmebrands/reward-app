# Web Push. Without these the app falls back to service-worker replay, which
# needs no server but only fires while the browser is running or on next launch.
# Generate a VAPID pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API=

# Register the service worker during `vite dev`. Off by default, because
# precaching fights hot reload — use `npm run preview` to test offline.
VITE_ENABLE_SW=
