# Serving the static site.
#
# Every location includes security-headers.conf. That repetition is load-bearing
# — see the comment in that file.

server {
    # Cloud Run injects PORT; envsubst fills it in at container start.
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # Cloud Run terminates TLS but does not compress for you — that is the
    # container's job.
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css image/svg+xml;

    # Cloud Run logs every request already; duplicating it doubles the bill.
    access_log  off;
    error_log   /var/log/nginx/error.log warn;

    # File names are not fingerprinted, so nothing is cached for long: a new
    # deploy must show on the next visit.
    location / {
        include     /etc/nginx/conf.d/security-headers.conf;
        add_header  Cache-Control "no-cache" always;
        # A missing page is a 404, not the home page.
        try_files   $uri $uri/ =404;
    }
}
