#!/usr/bin/env bash
# Runs the local verify gate before every push, so CI is not the first place
# a lint, type, test or build failure shows. Enabled per clone by `make init`
# (git config core.hooksPath .githooks). Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec make verify
